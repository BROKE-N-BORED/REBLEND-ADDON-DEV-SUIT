# Build output (regenerated by `python -m build`; never ship a stale copy)
build/
dist/
*.egg-info/

# Python caches
__pycache__/
*.pyc

# Secrets are never in code (immutable rule) — if a local secret file
# ever exists, it lives here and stays out of the repo.
.env
*.env
*.pem
*.key

# Renderer scratch (the PDF renderer runs with TMPDIR=tmp)
tmp/

# Local render venv (the PDF renderer runs in it; never ship it)
render-venv/

# The dossier PDF is a derived artifact — render_pdf.py rebuilds it
# from DOSSIER.md. The source is in the repo; the PDF is not.
Reblend-Addon-Dev-Suite-Dossier.pdf
