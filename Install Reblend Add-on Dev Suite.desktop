[Desktop Entry]
Type=Application
Name=Install Reblend Add-on Dev Suite
Comment=Install the Reblend Add-on Dev Suite (double-click, no terminal needed)
Exec=python3 -c "import os,subprocess,sys; d=os.path.dirname(sys.argv[1]) if len(sys.argv)>1 and sys.argv[1] else os.getcwd(); subprocess.call([sys.executable, os.path.join(d, 'installer', 'gui.py')])" %k
Icon=system-software-install
Terminal=false
Categories=Development;
